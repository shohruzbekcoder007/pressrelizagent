# =============================================================================
# Hermes host agent — starter
# =============================================================================

APP_NAME=PressRelizAgent
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8080
# Tashqi (host) port — brauzer/gateway shu portga ulanadi.
# Konteyner ichida xizmat baribir APP_PORT (8080) da turadi.
HOST_PORT=7100
LOG_LEVEL=INFO
LOG_DIR=./logs
LOG_FORMAT=json
TZ=UTC
PYTHONUNBUFFERED=1

# =============================================================================
# LLM — bitta almashtirgich
# =============================================================================
# openai   → 1-blok (OPENAI_*)
# ollama   → 2-blok (OLLAMA_*)
# vllm / lmstudio → ular ham 2-blokdan o'qiydi, faqat OLLAMA_BASE_URL ni
#                   o'sha serverga qarating
LLM_PROVIDER=openai

# --- 1-blok: OPENAI (LLM_PROVIDER=openai bo'lganda ishlaydi) ----------------
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4.1
# Title / tag / follow-up kabi mayda ishlar uchun arzon model (ixtiyoriy)
HERMES_TASK_MODEL=gpt-4.1-mini

# --- 2-blok: LOKAL SERVER (ollama | vllm | lmstudio shu blokdan o'qiydi) ----
# Docker ichidan host mashinadagi Ollama'ga: host.docker.internal
# Lokal (Docker'siz) ishlatishda: http://localhost:11434/v1
# LAN'dagi vLLM serveriga: http://<ip>:<port>/v1 (host.docker.internal EMAS)
OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
# Aniq nomni serverdan oling: curl -s <base_url>/models
OLLAMA_MODEL=qwen3:8b
# Title / tag kabi mayda ishlar uchun kichik model (tezroq, ixtiyoriy).
# Server bitta modelni bir nechta nom bilan ko'rsatishi mumkin — bunday holda
# alohida task-model yutuq bermaydi, task yo'nalishining o'zi beradi.
OLLAMA_TASK_MODEL=qwen3:8b
# Lokal server odatda kalit so'ramaydi — faqat proxy orqasida bo'lsa to'ldiring
# OLLAMA_API_KEY=

# Task-modelga yo'naltirishni butunlay o'chirish uchun false
HERMES_TASK_ROUTING=true

# =============================================================================
# Hermes host
# =============================================================================
HERMES_SYSTEM_PROMPT_PATH=prompts/hermes_coordinator.md
# Agent identity: prompts/soul.md -> $HERMES_HOME/SOUL.md (start.sh nusxalaydi).
# false = Hermes o'zining "You are Hermes Agent" identity'siga qaytadi.
HERMES_LOAD_SOUL_IDENTITY=true
# Comma-separated Hermes toolsets; empty = none
HERMES_ENABLED_TOOLSETS=memory,session_search,skills,todo,pressreliz
HERMES_MAX_ITERATIONS=12
HERMES_SESSION_HISTORY_LIMIT=6
# false = keep multi-turn history in host agent
HERMES_SKIP_MEMORY=false
HERMES_QUIET_MODE=true
HERMES_SKIP_CONTEXT_FILES=true
# OpenAI gpt-4* / gpt-4.1: must be false (Hermes default reasoning.effort breaks).
# Lokal "thinking" modellar (Qwen3, DeepSeek-R1, ...) uchun ham false qoldiring:
# aks holda javob `reasoning` maydoniga ketib, `content` bo'sh qaytishi mumkin.
HERMES_REASONING_ENABLED=false
# HERMES_REASONING_EFFORT=medium
HERMES_HOME=/home/appuser/.hermes
# Odatda kerak emas: LLM_PROVIDER dan avtomatik olinadi
# HERMES_INFERENCE_PROVIDER=openai

# --- raw_llm tool ------------------------------------------------------------
# Toza LLM chaqiruvi uchun timeout. Busiz model osilib qolsa, tool ham,
# agent turi ham, /v1/chat so'rovi ham osilib qoladi.
RAW_LLM_TIMEOUT_SECONDS=120
# OpenAI SDK sukut bo'yicha 2 marta qayta uradi; lokal serverda bu kutishni
# uch barobar qiladi.
RAW_LLM_MAX_RETRIES=1

CORS_ORIGINS=*
API_WORKERS=1
API_RELOAD=false
# API_BEARER_TOKEN=

HEALTHCHECK_URL=http://127.0.0.1:8080/health
HEALTHCHECK_TIMEOUT_SECONDS=5

# =============================================================================
# Neo4j — knowledge graph
# =============================================================================
# Neo4j edition va versiya. Dump `block` formatda VA 5.26 dan yangiroq
# serverda yaratilgan: block Community'da yo'q, downgrade esa umuman
# mumkin emas. Shuning uchun enterprise + 2026.07. Enterprise ishlab chiqish va
# test uchun bepul; produkshn uchun tijoriy litsenziya kerak.
NEO4J_IMAGE=neo4j:2026.07-enterprise
NEO4J_ACCEPT_LICENSE_AGREEMENT=yes

NEO4J_USER=neo4j
NEO4J_PASSWORD=pressreliz-neo4j
NEO4J_DATABASE=neo4j
# App konteynerdan Neo4j'ga compose tarmog'i orqali ulanadi (ichki port 7687)
NEO4J_URI=bolt://neo4j:7687
# Host tomonidagi portlar — 7474/7687 boshqa loyihada band
NEO4J_HTTP_PORT=7476
NEO4J_BOLT_PORT=7688
# Haqiqiy graf yuklangach ko'tarish mumkin
NEO4J_HEAP_INITIAL=512m
NEO4J_HEAP_MAX=1G
NEO4J_PAGECACHE=512m
